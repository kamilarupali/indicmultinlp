# IndicMultiNLP Environment Configuration Example

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Translation Engine Configuration
# Supported providers: 'mymemory' (neural MT with offline lexicon fallback)
TRANSLATION_PROVIDER=mymemory

# Optional: MyMemory translation email (increases free quota from 5,000 to 50,000 chars/day)
# Leave blank to use unauthenticated public tier
MYMEMORY_EMAIL=

# Translation HTTP timeout in seconds
TRANSLATION_TIMEOUT=5.0

# Enable verified offline domain lexicon fallback when offline or provider is unavailable
ENABLE_OFFLINE_FALLBACK=true
